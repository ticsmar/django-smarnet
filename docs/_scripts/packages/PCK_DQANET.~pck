                  -- SE n_os IGUAL A ZERO NAO ESTA LIBERADO
                     n_resposta := 0;
                     RETURN (n_resposta);-- ACESSO NEGADO

                  END IF;

            END IF; --- FIM IF (n_restricao > 0)

          END;

      END IF;


      --
      -- APROVACAO COMERCIAL
      --
      IF n_acesso = 173 THEN

       BEGIN

         BEGIN
           -- BUSCA DIVIS?O DA OS
