[importlinter:contract:domain-independence]
name = Domains are independent
type = independence
modules =
    apps.branch_auth
    apps.users
    apps.purchasing
    apps.commercial
    apps.files
    apps.administration
    apps.production
    apps.portal
ignore_imports =
    apps.shared.infrastructure.identity -> apps.users.infrastructure.models

[importlinter:contract:domain-no-django-oracle]
name = Domain cannot import Django or Oracle drivers
type = forbidden
source_modules =
    apps.shared.domain
    apps.users.domain
    apps.branch_auth.domain
    apps.purchasing.domain
    apps.commercial.domain
    apps.files.domain
    apps.administration.domain
    apps.production.domain
    apps.portal.domain
forbidden_modules =
    apps.followup
    django
    oracledb
    cx_Oracle
