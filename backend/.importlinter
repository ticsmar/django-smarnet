[importlinter]
root_packages =
    apps
include_external_packages = True

[importlinter:contract:shared-domain-isolation]
name = Shared domain layer isolation
type = forbidden
source_modules =
    apps.shared.domain
forbidden_modules =
    apps.shared.application
    apps.shared.infrastructure
    apps.shared.presentation

[importlinter:contract:users-layers]
name = Users layer dependencies
type = layers
layers =
    apps.users.presentation
    apps.users.application
    apps.users.domain

[importlinter:contract:users-domain-isolation]
name = Users domain layer isolation
type = forbidden
source_modules =
    apps.users.domain
forbidden_modules =
    apps.users.application
    apps.users.infrastructure
    apps.users.presentation

[importlinter:contract:users-app-no-presentation]
name = Users application cannot import presentation
type = forbidden
source_modules =
    apps.users.application
forbidden_modules =
    apps.users.presentation

[importlinter:contract:users-infra-boundary]
name = Users infrastructure boundary
type = forbidden
source_modules =
    apps.users.infrastructure
forbidden_modules =
    apps.users.application
    apps.users.presentation

[importlinter:contract:shared-presentation-isolation]
name = Shared presentation cannot import domain modules
type = forbidden
source_modules =
    apps.shared.presentation
forbidden_modules =
    apps.users


[importlinter:contract:branch_auth-layers]
name = BranchAuth layer dependencies
type = layers
layers =
    apps.branch_auth.presentation
    apps.branch_auth.application
    apps.branch_auth.domain

[importlinter:contract:branch_auth-domain-isolation]
name = BranchAuth domain layer isolation
type = forbidden
source_modules =
    apps.branch_auth.domain
forbidden_modules =
    apps.branch_auth.application
    apps.branch_auth.infrastructure
    apps.branch_auth.presentation

[importlinter:contract:branch_auth-app-no-presentation]
name = BranchAuth application cannot import presentation
type = forbidden
source_modules =
    apps.branch_auth.application
forbidden_modules =
    apps.branch_auth.presentation

[importlinter:contract:branch_auth-infra-boundary]
name = BranchAuth infrastructure boundary
type = forbidden
source_modules =
    apps.branch_auth.infrastructure
forbidden_modules =
    apps.branch_auth.application
    apps.branch_auth.presentation

[importlinter:contract:compras-layers]
name = compras layer dependencies
type = layers
layers =
    apps.compras.presentation
    apps.compras.application
    apps.compras.domain

[importlinter:contract:compras-domain-isolation]
name = compras domain layer isolation
type = forbidden
source_modules =
    apps.compras.domain
forbidden_modules =
    apps.compras.application
    apps.compras.infrastructure
    apps.compras.presentation

[importlinter:contract:compras-app-no-presentation]
name = compras application cannot import presentation
type = forbidden
source_modules =
    apps.compras.application
forbidden_modules =
    apps.compras.presentation

[importlinter:contract:compras-infra-boundary]
name = compras infrastructure boundary
type = forbidden
source_modules =
    apps.compras.infrastructure
forbidden_modules =
    apps.compras.application
    apps.compras.presentation

[importlinter:contract:administracao-layers]
name = administracao layer dependencies
type = layers
layers =
    apps.administracao.presentation
    apps.administracao.application
    apps.administracao.domain

[importlinter:contract:administracao-domain-isolation]
name = administracao domain layer isolation
type = forbidden
source_modules =
    apps.administracao.domain
forbidden_modules =
    apps.administracao.application
    apps.administracao.infrastructure
    apps.administracao.presentation

[importlinter:contract:administracao-app-no-presentation]
name = administracao application cannot import presentation
type = forbidden
source_modules =
    apps.administracao.application
forbidden_modules =
    apps.administracao.presentation

[importlinter:contract:administracao-infra-boundary]
name = administracao infrastructure boundary
type = forbidden
source_modules =
    apps.administracao.infrastructure
forbidden_modules =
    apps.administracao.application
    apps.administracao.presentation

[importlinter:contract:domain-independence]
name = Domains are independent
type = independence
modules =
    apps.branch_auth
    apps.users
    apps.compras
    apps.administracao
ignore_imports =
    apps.administracao.infrastructure.actor_context -> apps.users.infrastructure.models
    apps.administracao.infrastructure.actor_context -> apps.users.infrastructure.oracle_session_context
    apps.administracao.infrastructure.repositories.oracle_cliente_repository_impl -> apps.users.infrastructure.oracle_session_context
    apps.administracao.infrastructure.repositories.oracle_cliente_query_repository_impl -> apps.users.infrastructure.oracle_session_context

[importlinter:contract:domain-no-django-oracle]
name = Domain cannot import Django or Oracle drivers
type = forbidden
source_modules =
    apps.shared.domain
    apps.users.domain
    apps.branch_auth.domain
    apps.compras.domain
    apps.administracao.domain
forbidden_modules =
    django
    oracledb
    cx_Oracle
