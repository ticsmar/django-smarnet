[importlinter]
root_packages =
    apps
include_external_packages = True

[importlinter:contract:shared-domain-isolation]
name = Shared domain layer isolation
type = forbidden
source_modules =
    apps.shared.domain
forbidden_modules =
    apps.shared.application
    apps.shared.infrastructure
    apps.shared.presentation

[importlinter:contract:users-layers]
name = Users layer dependencies
type = layers
layers =
    apps.users.presentation
    apps.users.application
    apps.users.domain

[importlinter:contract:users-domain-isolation]
name = Users domain layer isolation
type = forbidden
source_modules =
    apps.users.domain
forbidden_modules =
    apps.users.application
    apps.users.infrastructure
    apps.users.presentation

[importlinter:contract:users-app-no-presentation]
name = Users application cannot import presentation
type = forbidden
source_modules =
    apps.users.application
forbidden_modules =
    apps.users.presentation

[importlinter:contract:users-infra-boundary]
name = Users infrastructure boundary
type = forbidden
source_modules =
    apps.users.infrastructure
forbidden_modules =
    apps.users.application
    apps.users.presentation

[importlinter:contract:shared-presentation-isolation]
name = Shared presentation cannot import domain modules
type = forbidden
source_modules =
    apps.shared.presentation
forbidden_modules =
    apps.users


