# Oracle
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_SMAR_USER=
ORACLE_SMAR_PASSWORD=
# Oracle connection
ORACLE_HOST=
ORACLE_PORT=
ORACLE_SERVICE_NAME=
ORACLE_CLIENT_PATH=
# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
# Set to true only for local/dev bootstrap (self-registration). Production: false.
ALLOW_PUBLIC_REGISTER=false
# ReceitaWS token used by the new-customer CNPJ wizard (same Bearer as 3.0 getCNPJ.php).
RECEITAWS_TOKEN=
